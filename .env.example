# "off" desliga as quiet hours (útil para smoke tests).
QUIET_HOURS=23-7
FB_MAX_JOBS_PER_HOUR=6
FB_MIN_GAP=4m
# Formato aceito pelo Go time.ParseDuration (ex.: 168h). Default já é esse.
LISTING_UNSEEN_AFTER=168h
RAW_CAPTURES_RETENTION=336h
